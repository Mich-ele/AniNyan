{
    "designSystem": {
      "name": "Anime Streaming App Design System",
      "version": "1.0",
      "description": "Dark-themed mobile streaming app with vivid anime-style visual elements",
      
      "colorPalette": {
        "primary": {
          "background": "#101014",
          "backgroundSecondary": "#101014",
          "backgroundTertiary": "#101014"
        },
        "accent": {
          "primary": "#ff6b35",
          "secondary": "#ff8c42",
          "gradient": "linear-gradient(135deg, #ff6b35, #ff8c42, #ffaa5c)"
        },
        "text": {
          "primary": "#ffffff",
          "secondary": "#b3b3b3",
          "tertiary": "#808080"
        },
        "interactive": {
          "cardOverlay": "rgba(0, 0, 0, 0.7)",
          "buttonActive": "#ff6b35",
          "buttonInactive": "#666666"
        }
      },
  
      "typography": {
        "fontFamily": {
          "primary": "Raleway-Regular",
          "secondary": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif"
        },
        "sizes": {
          "display": "48px",
          "hero": "48px",
          "title": "24px",
          "subtitle": "18px",
          "body": "16px",
          "caption": "14px",
          "small": "12px"
        },
        "weights": {
          "light": 300,
          "regular": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        }
      },
  
      "spacing": {
        "xs": "4px",
        "sm": "8px",
        "md": "16px",
        "lg": "24px",
        "xl": "32px",
        "xxl": "48px"
      },
  
      "borderRadius": {
        "small": "8px",
        "medium": "12px",
        "large": "16px",
        "xlarge": "20px",
        "round": "50%"
      },
  
      "shadows": {
        "card": "0 4px 20px rgba(0, 0, 0, 0.3)",
        "elevated": "0 8px 32px rgba(0, 0, 0, 0.4)",
        "subtle": "0 2px 8px rgba(0, 0, 0, 0.2)"
      },
  
      "layout": {
        "screenStructure": {
          "statusBar": {
            "height": "44px",
            "style": "light-content"
          },
          "header": {
            "height": "60px",
            "padding": "16px",
            "alignment": "space-between"
          },
          "content": {
            "padding": "16px",
            "scrollable": true
          },
          "tabBar": {
            "height": "80px",
            "style": "floating",
            "backgroundColor": "rgba(26, 26, 26, 0.95)"
          }
        },
        
        "grid": {
          "columns": 12,
          "gutter": "16px",
          "margin": "16px"
        }
      },
  
      "components": {
        "navigationBar": {
          "style": "transparent",
          "title": {
            "fontSize": "18px",
            "fontWeight": "semibold",
            "color": "#ffffff",
            "alignment": "center"
          },
          "backButton": {
            "iconSize": "24px",
            "color": "#ffffff"
          }
        },
  
        "searchBar": {
          "backgroundColor": "rgba(255, 255, 255, 0.1)",
          "borderRadius": "medium",
          "height": "44px",
          "padding": "12px 16px",
          "placeholder": {
            "color": "#b3b3b3",
            "fontSize": "16px"
          },
          "icon": {
            "size": "20px",
            "color": "#b3b3b3"
          }
        },
  
        "cards": {
          "poster": {
            "aspectRatio": "3:4",
            "borderRadius": "large",
            "shadow": "card",
            "overlay": {
              "gradient": "linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.8) 100%)",
              "padding": "16px"
            },
            "title": {
              "fontSize": "subtitle",
              "fontWeight": "semibold",
              "color": "#ffffff",
              "position": "bottom-left"
            }
          },
          
          "episode": {
            "aspectRatio": "16:9",
            "borderRadius": "medium",
            "backgroundColor": "#2a2a2a",
            "layout": "horizontal",
            "thumbnail": {
              "width": "120px",
              "borderRadius": "small"
            },
            "content": {
              "padding": "12px",
              "title": {
                "fontSize": "body",
                "fontWeight": "medium",
                "color": "#ffffff"
              },
              "subtitle": {
                "fontSize": "caption",
                "color": "#b3b3b3"
              }
            }
          },
  
          "feature": {
            "aspectRatio": "16:9",
            "borderRadius": "xlarge",
            "backgroundType": "image",
            "overlay": {
              "gradient": "linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.7) 100%)"
            },
            "content": {
              "position": "bottom-left",
              "padding": "24px",
              "title": {
                "fontSize": "hero",
                "fontWeight": "bold",
                "color": "#ffffff"
              },
              "subtitle": {
                "fontSize": "body",
                "color": "#b3b3b3"
              }
            }
          }
        },
  
        "buttons": {
          "primary": {
            "backgroundColor": "#ff6b35",
            "borderRadius": "medium",
            "height": "48px",
            "fontSize": "body",
            "fontWeight": "semibold",
            "color": "#ffffff"
          },
          "secondary": {
            "backgroundColor": "transparent",
            "border": "2px solid #ff6b35",
            "borderRadius": "medium",
            "height": "48px",
            "fontSize": "body",
            "fontWeight": "semibold",
            "color": "#ff6b35"
          },
          "icon": {
            "backgroundColor": "rgba(255, 255, 255, 0.1)",
            "borderRadius": "round",
            "size": "40px",
            "iconSize": "20px",
            "color": "#ffffff"
          }
        },
  
        "sections": {
          "header": {
            "marginBottom": "16px",
            "title": {
              "fontSize": "title",
              "fontWeight": "bold",
              "color": "#ffffff"
            },
            "action": {
              "fontSize": "body",
              "color": "#ff6b35",
              "alignment": "right"
            }
          },
          
          "horizontalScroll": {
            "padding": "0 16px",
            "itemSpacing": "12px",
            "showsScrollIndicator": false
          },
          
          "grid": {
            "columns": 2,
            "spacing": "12px",
            "padding": "0 16px"
          }
        },
  
        "profile": {
          "header": {
            "backgroundType": "gradient",
            "gradient": "linear-gradient(135deg, #ff6b35, #ff8c42)",
            "height": "200px",
            "content": {
              "alignment": "center",
              "avatar": {
                "size": "80px",
                "borderRadius": "round",
                "border": "4px solid #ffffff"
              },
              "name": {
                "fontSize": "title",
                "fontWeight": "bold",
                "color": "#ffffff",
                "marginTop": "12px"
              },
              "handle": {
                "fontSize": "body",
                "color": "rgba(255, 255, 255, 0.8)"
              }
            }
          },
          
          "stats": {
            "layout": "horizontal",
            "distribution": "equal",
            "item": {
              "alignment": "center",
              "number": {
                "fontSize": "title",
                "fontWeight": "bold",
                "color": "#ffffff"
              },
              "label": {
                "fontSize": "caption",
                "color": "#b3b3b3"
              }
            }
          }
        },
  
        "tabBar": {
          "style": "floating",
          "backgroundColor": "#101014",
          "backdropFilter": "blur(20px)",
          "borderRadius": "xlarge",
          "margin": "16px",
          "height": "60px",
          "items": {
            "active": {
              "iconColor": "#ffffff",
              "backgroundColor": "rgba(255, 107, 53, 0.1)"
            },
            "inactive": {
              "iconColor": "#8E8E93"
            },
            "iconSize": "24px"
          }
        }
      },
  
      "animations": {
        "cardHover": {
          "scale": "1.05",
          "duration": "0.2s",
          "easing": "ease-out"
        },
        "buttonPress": {
          "scale": "0.95",
          "duration": "0.1s"
        },
        "pageTransition": {
          "type": "slide",
          "duration": "0.3s",
          "easing": "ease-in-out"
        },
        "fadeIn": {
          "opacity": "0 to 1",
          "duration": "0.4s",
          "easing": "ease-out"
        }
      },
  
      "patterns": {
        "contentDiscovery": {
          "structure": [
            "hero/featured content",
            "continue watching section",
            "trending/popular sections",
            "categorized content rows",
            "personalized recommendations"
          ]
        },
        
        "navigation": [
          "bottom tab navigation",
          "header with search",
          "floating action elements",
          "contextual back buttons"
        ],
        
        "contentPresentation": [
          "poster grid for shows/movies",
          "horizontal scrolling carousels",
          "episode lists with thumbnails",
          "featured content with large imagery"
        ]
      },
  
      "responsive": {
        "breakpoints": {
          "mobile": "320px - 767px",
          "tablet": "768px - 1023px",
          "desktop": "1024px+"
        },
        
        "adaptations": {
          "mobile": {
            "cardColumns": 2,
            "padding": "16px",
            "fontSize": "base"
          },
          "tablet": {
            "cardColumns": 3,
            "padding": "24px",
            "fontSize": "larger"
          }
        }
      },
  
      "accessibility": {
        "contrast": {
          "minimum": "4.5:1",
          "preferred": "7:1"
        },
        "focusStates": {
          "outline": "2px solid #ff6b35",
          "outlineOffset": "2px"
        },
        "tapTargets": {
          "minimum": "44px"
        }
      }
    }
  }